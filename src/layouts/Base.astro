---
import 'lxgw-wenkai-screen-webfont/lxgwwenkaiscreen.css';
import '../styles/global.css';
import Icon from '../components/Icons.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  slogan?: string;
  bodyId: 'post-index' | 'post' | 'page';
  active?: 'about';
  type?: 'website' | 'article';
  hasToc?: boolean;
}

const { title, description = SITE.description, slogan = SITE.slogan, bodyId, active, type = 'website', hasToc = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 中文标语用更大字号和字距，与英文区分
const isCJK = /[一-鿿]/.test(slogan);
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f5f4ed" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} Feed`} href="/feed.xml" />
  </head>
  <body id={bodyId} class:list={{ 'has-post-toc': hasToc }}>
    <div class="header-menu" id="J_header">
      <ul class="header-item-container">
        <li class="header-item-title"><a href="/" class="title">{SITE.title}</a></li>
        <li class="header-item-left"><a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <li class:list={['header-item-left', { active: active === 'about' }]}><a href="/about/">About</a></li>
        <li class="header-item search-btn-container">
          <button id="search-btn" class="search-btn" aria-label="Search" title="Search (Press /)">
            <Icon name="search" />
          </button>
        </li>
      </ul>
    </div>

    <div class="entry-header">
      <svg width="100%" height="200" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" role="img" aria-label={slogan}>
        <path id="svg-title-path" d="m0,110 h1600">
          <animate attributeName="d" from="m0,110 h80" to="m0,110 h1600" dur={isCJK ? '2550ms' : '3000ms'} repeatCount="1" fill="freeze" begin="0s" />
        </path>
        <text font-size={isCJK ? 42 : 36} font-weight={isCJK ? 400 : 600} fill="#f3ebdb" x="50%" y="50%" text-anchor="middle" word-spacing="2" letter-spacing={isCJK ? 4 : 1.2}>
          <textPath href="#svg-title-path" xlink:href="#svg-title-path">{slogan}</textPath>
        </text>
      </svg>
      <canvas id="J_firework_canvas" aria-hidden="true"></canvas>
    </div>

    <main id="main">
      <slot />
    </main>

    <div id="search-modal" class="search-modal" aria-hidden="true" role="dialog" aria-label="Search">
      <div class="search-container">
        <div class="search-header">
          <input type="search" id="search-input" class="search-input" placeholder="Search articles..." aria-label="Search articles" autocomplete="off" />
          <button class="search-close" id="search-close" aria-label="Close search"><Icon name="close" /></button>
        </div>
        <div id="search-results" class="search-results" role="listbox"></div>
        <div class="search-footer">
          <div class="search-tips">
            <kbd>/</kbd> to search <kbd>ESC</kbd> to close <kbd>↑↓</kbd> to navigate <kbd>Enter</kbd> to select
          </div>
        </div>
      </div>
    </div>

    <div class="footer-wrapper">
      <footer>
        <a href={SITE.github} rel="nofollow noopener" target="_blank" class="social-icon" aria-label="GitHub"><Icon name="github" /></a>
        {SITE.email && <a href={`mailto:${SITE.email}`} class="social-icon" aria-label="Email"><Icon name="mail" /></a>}
        <a href="/feed.xml" target="_blank" class="social-icon" aria-label="RSS"><Icon name="rss" /></a>
      </footer>
    </div>

    <script>
      import '../scripts/main';
      import '../scripts/search';
    </script>
  </body>
</html>
