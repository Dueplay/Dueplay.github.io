---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../utils';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getPosts();
  const total = Math.ceil(posts.length / SITE.pageSize);
  // 第 1 页由首页承担
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: { posts: posts.slice((page - 1) * SITE.pageSize, page * SITE.pageSize), current: page, total },
    };
  });
}

const { posts, current, total } = Astro.props;
---
<Base bodyId="post-index" title={`第 ${current} 页`}>
  <PostList posts={posts} current={current} total={total} />
</Base>
